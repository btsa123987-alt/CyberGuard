# Default local-only listener; set HOST=0.0.0.0 only inside containers/private networks.
HOST=127.0.0.1
PORT=5000
# Server history is disabled by default. If enabled, stores hostnames only.
CYBERGUARD_HISTORY=0
# Best-effort per-worker limit; production gateway needs its own rate limiting.
CYBERGUARD_RATE_LIMIT=40
