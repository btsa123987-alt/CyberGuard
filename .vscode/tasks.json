{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CyberGuard: Set up environment",
      "type": "process",
      "command": "py",
      "args": [
        "-3",
        "${workspaceFolder}/scripts/vscode_setup.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CyberGuard: Run tests",
      "type": "shell",
      "command": "& .\\.venv\\Scripts\\python.exe -m pip install -r requirements-dev.txt; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & .\\.venv\\Scripts\\python.exe -m pytest tests -v",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile",
            "-Command"
          ]
        }
      },
      "dependsOn": [
        "CyberGuard: Set up environment"
      ],
      "problemMatcher": []
    }
  ]
}
