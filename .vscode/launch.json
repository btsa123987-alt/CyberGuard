{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CyberGuard: Run Flask (Windows)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "5000"
      },
      "preLaunchTask": "CyberGuard: Set up environment"
    }
  ]
}
